{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build zenos",
            "type": "shell",
            "command": "./build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run QEMU (debug)",
            "type": "shell",
            "command": "./qemu.sh -d",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^never matches$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Running iso\\.h$",
                    "endsPattern": "^Set up for GDB$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Stop QEMU",
            "type": "shell",
            "command": "pkill -f 'qemu-system-i386 -s -S -cdrom zenos.iso' || true",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
